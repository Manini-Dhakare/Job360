# ==============================================================================
# ENVIRONMENT CONFIGURATION - AI-POWERED CAREER PLATFORM (JOB360)
# ==============================================================================
# Copy this file to .env and adjust values for local development.

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL & pgvector Database Configuration
POSTGRES_USER=job360_user
POSTGRES_PASSWORD=job360_password
POSTGRES_DB=job360_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://job360_user:job360_password@postgres:5432/job360_db
SYNC_DATABASE_URL=postgresql://job360_user:job360_password@postgres:5432/job360_db

# Redis & Celery Task Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT & Authentication (Phase 1)
JWT_SECRET_KEY=change_this_to_a_jwt_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI / LLM & PyTorch Inference Configuration (Phases 2-8)
OPENAI_API_KEY=your_openai_api_key_here
TORCH_DEVICE=cpu
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage (AWS S3 / Cloudflare R2)
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=job360-resumes
CLOUDFLARE_R2_ENDPOINT=

# Stripe Billing & Monetization (Phase 6)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# External Job Providers (Phase 3)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
JSEARCH_RAPIDAPI_KEY=

# Email / Notifications (SendGrid)
SENDGRID_API_KEY=
SENDER_EMAIL=alerts@job360.ai

# Observability (Phase 9)
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true
